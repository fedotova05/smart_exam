<?xml version='1.0' encoding='utf-8'?>
<CodeBlocks_project_file>
  <FileVersion major="1" minor="6" />
  <Project>
    <Option title="SmartExam tests" />
    <Option compiler="gcc" />
    <Build>
      <Target title="Debug">
        <Option output="../bin/Debug/tests" prefix_auto="1" extension_auto="1" />
        <Option object_output="../obj/tests/Debug/" />
        <Option type="1" />
        <Option working_dir=".." />
        <Compiler>
          <Add option="-g" />
        </Compiler>
      </Target>
      <Target title="Release">
        <Option output="../bin/Release/tests" prefix_auto="1" extension_auto="1" />
        <Option object_output="../obj/tests/Release/" />
        <Option type="1" />
        <Option working_dir=".." />
        <Compiler>
          <Add option="-O2" />
        </Compiler>
      </Target>
    </Build>
    <Compiler>
      <Add option="-std=c++11" />
      <Add option="-Wall" />
      <Add option="-Wextra" />
      <Add option="-finput-charset=UTF-8" />
      <Add option="-fexec-charset=UTF-8" />
      <Add directory="../src" />
    </Compiler>
    <Unit filename="../src/core/Services.h" />
    <Unit filename="../src/core/Types.h" />
    <Unit filename="../tests/main.cpp" />
    <Unit filename="../tests/Test.h" />
  </Project>
</CodeBlocks_project_file>